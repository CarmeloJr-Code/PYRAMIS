{
	# The default is twice the CPUs the host reports, which on this instance is
	# 2 threads; a slow request (an AI reading, a hover prefetch) then left one
	# thread for everyone else. Four doubles that. Each thread keeps a persistent
	# database connection (DB_PERSISTENT), so four stays well inside the roughly
	# fifteen the Supavisor session pooler gives the project.
	frankenphp {
		num_threads 4
	}
	auto_https off
	admin off
	log {
		output stderr
	}
}

{$SERVER_NAME} {
	root /app/public
	encode zstd br gzip
	php_server
}
