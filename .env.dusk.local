# The environment the browser journeys run against.
#
# Dusk swaps this in for .env while `php artisan dusk` runs, so the journeys
# never touch the database anyone is developing against — the browser tests
# migrate from empty on every run, and doing that to a working database would
# throw away the day's work. Committed on purpose: it holds nothing secret,
# and a journey that cannot be run by whoever checks out the repo is no gate.
APP_NAME=PYRAMIS
APP_ENV=local
# Test-only, and never used to encrypt anything that outlives a run. Production
# holds its own key, set on Render and in no file here.
APP_KEY=base64:RqwVGyOS/u+6O7V15JgNyrZ30lkrRS9GIBGHyg5JLE0=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Four rounds rather than twelve: the journeys sign in repeatedly, and hashing
# is otherwise most of their running time.
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Its own file, never the one in .env. database/dusk.sqlite is ignored by git
# and rebuilt by the migrations each run.
DB_CONNECTION=sqlite
DB_DATABASE=database/dusk.sqlite
DB_URL=

# Files rather than the database, so a request writing a session or a cache
# entry is not racing the migrations that are rebuilding those tables.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Deliberately blank. The forecast journey reads the deterministic outlook,
# which is worked out in PHP and SQL; the AI reading is asked for by a button
# the journey never presses, so no provider is called and no key is needed.
GROQ_API_KEY=
